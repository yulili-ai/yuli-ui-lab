{
  "name": "yuli-ui-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:serve": "node scripts/registry-server.mjs",
    "mcp:check": "node scripts/mcp-check.mjs",
    "test": "node --test scripts/*.test.mjs",
    "setup": "node scripts/setup-mcp.mjs && npm run registry:build",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "build:public": "tsc -b && vite build --mode public"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
